PORT=3143
DATABASE_URL=postgres://marco:marco@localhost:5432/marco_dev?sslmode=disable
GOOGLE_CLIENT_ID=your_ios_oauth_client_id
JWT_SECRET=a_random_32_char_string_minimum
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
ANTHROPIC_API_KEY=

# Password-reset email. SENDGRID_FROM_EMAIL must be a verified Sender Identity
# in the SendGrid account or every send comes back 403.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=marco@yourdomain.com
SENDGRID_FROM_NAME=Marco
# Leave unset everywhere real. Point it at a local stand-in to exercise the
# reset flow without mailing anyone from a dev machine.
# SENDGRID_BASE_URL=http://127.0.0.1:8899
